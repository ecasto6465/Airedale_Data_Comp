    "#1.3\n",
    "import numpy as np, pandas as pd\n",
    "import statsmodels.formula.api as smf\n",
    "from statsmodels.stats.anova import anova_lm\n",
    "\n",
    "df = pd.read_excel(\"DataSets/Competition_Dataset_Final.xlsx\")\n",
    "df[\"cost\"] = df[\"Repair Cost Field Service\"]\n",
    "df[\"LX\"]   = (df[\"Product Family\"] == \"LegacyX\").astype(int)\n",
    "df[\"fail\"] = df[\"Failure Description\"]\n",
    "\n",
    "# ---- 1. HEADLINE ----\n",
    "g = df.groupby(\"LX\")[\"cost\"].agg(units=\"count\", mean=\"mean\", total=\"sum\")\n",
    "print(g.round(0))\n",
    "print(\"share units %.3f | share cost %.3f | mean ratio %.3f\\n\" %\n",
    "      (g.units[1]/g.units.sum(), g.total[1]/g.total.sum(), g[\"mean\"][1]/g[\"mean\"][0]))\n",
    "\n",
    "# ---- 2. FREQUENCY: failure mix by family (%) ----\n",
    "print((pd.crosstab(df[\"Product Family\"], df[\"Failure Category\"], normalize=\"index\")*100).round(1), \"\\n\")\n",
    "\n",
    "# ---- 3. SEVERITY: mean cost within each failure type ----\n",
    "sev = df.pivot_table(index=\"fail\", columns=\"LX\", values=\"cost\", aggfunc=\"mean\")\n",
    "sev[\"ratio\"] = sev[1] / sev[0]\n",
    "print(sev.round(2), \"\\n\")\n",
    "\n",
    "# ---- 4. DECOMPOSITION with bootstrap CI ----\n",
    "def decomp(d):\n",
    "    o, l = d[d.LX == 0], d[d.LX == 1]\n",
    "    mo, ml = o.fail.value_counts(normalize=True), l.fail.value_counts(normalize=True)\n",
    "    so, sl = o.groupby(\"fail\").cost.mean(), l.groupby(\"fail\").cost.mean()\n",
    "    idx = mo.index\n",
    "    mo, ml, so, sl = mo[idx], ml.reindex(idx).fillna(0), so[idx], sl.reindex(idx)\n",
    "    freq = ((ml - mo) * so).sum()           # mix difference, at other families' costs\n",
    "    sevr = (ml * (sl - so)).sum()           # cost difference, at LegacyX's mix\n",
    "    return freq, sevr, freq + sevr\n",
    "f, s, t = decomp(df)\n",
    "print(\"gap per failing unit: total %.0f = frequency %.0f + severity %.0f\" % (t, f, s))\n",
    "rng = np.random.default_rng(0)\n",
    "bs = np.array([decomp(df.sample(len(df), replace=True, random_state=int(rng.integers(1e9))))\n",
    "               for _ in range(2000)])\n",
    "print(\"95%% CI frequency [%.0f, %.0f] | severity [%.0f, %.0f]\\n\" %\n",
    "      (*np.percentile(bs[:, 0], [2.5, 97.5]), *np.percentile(bs[:, 1], [2.5, 97.5])))\n",
    "\n",
    "# ---- 5. MULTIPLICATIVE PREMIUM ----\n",
    "m  = smf.ols(\"np.log(cost) ~ C(fail) + LX\", df).fit()\n",
    "b, ci = m.params[\"LX\"], m.conf_int().loc[\"LX\"]\n",
    "print(\"LegacyX premium: x%.3f (95%% CI %.3f-%.3f)\" % tuple(np.exp([b, ci[0], ci[1]])))\n",
    "m2 = smf.ols(\"np.log(cost) ~ C(fail) * LX\", df).fit()\n",
    "print(\"Premium differs by failure type? p = %.3f\" % anova_lm(m, m2)[\"Pr(>F)\"][1])\n",
    "\n",
    "# ---- 6. DOES THE PREMIUM DEPEND ON WHERE/HOW THE UNIT WAS BUILT? ----\n",
    "for v in [\"Facility\", \"Coil Supplier\", \"Controls Revision\", \"Shift\"]:\n",
    "    a = smf.ols(f\"np.log(cost) ~ C(fail) + LX + C(Q('{v}'))\", df).fit()\n",
    "    c = smf.ols(f\"np.log(cost) ~ C(fail) + LX * C(Q('{v}'))\", df).fit()\n",
    "    print(f\"premium x {v}: p = {anova_lm(a, c)['Pr(>F)'][1]:.3f}\")"
   ]
