    "\n",
    "# ---------- 3. CANDIDATE MODELS (each: fit on train -> predict on test) ----------\n",
    "EPS = 1e-3\n",
    "def fit_null(tr, te):\n",
    "    return np.full(len(te), tr.leak.mean())\n",
    "\n",
    "def _logit(cols):\n",
    "    def f(tr, te):\n",
    "        m = LogisticRegression(C=1.0, max_iter=1000).fit(tr[cols], tr.leak)   # L2 penalty handles separation\n",
    "        return m.predict_proba(te[cols])[:, 1]\n",
    "    return f\n",
    "fit_additive    = _logit([\"F2\", \"SB\"])\n",
    "fit_interaction = _logit([\"F2\", \"SB\", \"F2xSB\"])\n",
    "\n",
    "def fit_either(tr, te):   # one switch: risk = F2 OR SB; rate per group (lightly smoothed)\n",
    "    r = ((tr.F2 | tr.SB) == 1)\n",
    "    p1 = (tr.leak[r].sum() + .5) / (r.sum() + 1); p0 = (tr.leak[~r].sum() + .5) / ((~r).sum() + 1)\n",
    "    return np.where((te.F2 | te.SB) == 1, p1, p0)\n",
    "\n",
    "def _or_pred(theta, F2, SB):\n",
    "    a, b, c = 1 / (1 + np.exp(-theta))           # base, F2 effect, SB effect (all in 0-1)\n",
    "    return 1 - (1 - a) * (1 - b * F2) * (1 - c * SB)\n",
    "def fit_noisyor(tr, te):\n",
    "    def nll(t):\n",
    "        p = np.clip(_or_pred(t, tr.F2.values, tr.SB.values), 1e-9, 1 - 1e-9)\n",
    "        return -(tr.leak.values * np.log(p) + (1 - tr.leak.values) * np.log(1 - p)).sum()\n",
    "    th = minimize(nll, [-3, 0, 0], method=\"Nelder-Mead\", options={\"maxiter\": 4000}).x\n",
    "    return _or_pred(th, te.F2.values, te.SB.values)\n",
    "\n",
    "models = {\"null\": fit_null, \"additive\": fit_additive, \"noisy-OR\": fit_noisyor,\n",
    "          \"either-factor switch\": fit_either, \"interaction\": fit_interaction}\n",
    "\n",
    "# ---------- 4. REPEATED CROSS-VALIDATION ----------\n",
    "def logloss(y, p):\n",
    "    p = np.clip(p, EPS, 1 - EPS); return -np.mean(y * np.log(p) + (1 - y) * np.log(1 - p))\n",
    "cv = RepeatedStratifiedKFold(n_splits=5, n_repeats=10, random_state=42)\n",
    "strat = df.F2.astype(str) + df.SB.astype(str)          # stratify on the 4 cells so every fold has all of them\n",
    "scores = {k: [] for k in models}\n",
    "for tr_i, te_i in cv.split(df, strat):\n",
    "    tr, te = df.iloc[tr_i], df.iloc[te_i]\n",
    "    for name, fn in models.items():\n",
    "        scores[name].append(logloss(te.leak.values, fn(tr, te)))\n",
    "print(pd.DataFrame({k: [np.mean(v), np.std(v)] for k, v in scores.items()}, index=[\"mean\", \"sd\"]).T.round(4), \"\\n\")\n",
    "\n",
    "# ---------- 5. ARE THE TWO FACTORS INDEPENDENT? (bootstrap test on the 'both' cell) ----------\n",
    "rng = np.random.default_rng(0)\n",
    "def or_both(d):\n",
    "    a = d[(d.F2 == 1) & (d.SB == 0)].leak.mean(); b = d[(d.F2 == 0) & (d.SB == 1)].leak.mean()\n",
    "    return 1 - (1 - a) * (1 - b)          # what independence would predict for units with both\n",
    "gaps = []\n",
    "for _ in range(2000):\n",
    "    s = df.sample(len(df), replace=True, random_state=int(rng.integers(1e9)))\n",
    "    gaps.append(s[(s.F2 == 1) & (s.SB == 1)].leak.mean() - or_both(s))\n",
    "obs = df[(df.F2 == 1) & (df.SB == 1)].leak.mean()\n",
    "print(f\"observed 'both' rate {obs:.3f} | independence predicts {or_both(df):.3f} | \"\n",
    "      f\"gap 95% CI {np.percentile(gaps, [2.5, 97.5]).round(3)}\\n\")\n",
    "\n",
    "# ---------- 6. DOES ANYTHING ELSE MATTER INSIDE THE RISK GROUP? ----------\n",
    "risk = df[(df.F2 | df.SB) == 1]\n",
    "for v in [\"Shift\", \"Product Family\", \"Customer Region\", \"Controls Revision\", \"Facility\", \"Coil Supplier\"]:\n",
    "    t = pd.crosstab(risk[v], risk.leak); print(f\"{v:18s} chi2 p = {chi2_contingency(t)[1]:.3f}\")"
