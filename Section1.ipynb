    "#1.4\n",
    "df = pd.read_excel(\"DataSets/Competition_Dataset_Final.xlsx\")\n",
    "df[\"cost\"] = df[\"Repair Cost Field Service\"]\n",
    "df[\"risk\"] = ((df.Facility == \"Facility 2\") | (df[\"Coil Supplier\"] == \"Supplier B\")).astype(int)\n",
    "rng = np.random.default_rng(0); TOT = df.cost.sum()\n",
    "\n",
    "def table(by):\n",
    "    rows = []\n",
    "    for k, g in df.groupby(by):\n",
    "        v = g.cost.values\n",
    "        bs = [v[rng.integers(0, len(v), len(v))].sum() for _ in range(2000)]\n",
    "        lo, hi = np.percentile(bs, [2.5, 97.5])\n",
    "        rows.append((k, len(g), len(g)/len(df), v.sum(), lo, hi, v.sum()/TOT, v.mean()))\n",
    "    return pd.DataFrame(rows, columns=[\"group\",\"units\",\"%units\",\"total cost\",\"lo\",\"hi\",\"%cost\",\"mean cost\"]).round(3)\n",
    "\n",
    "for b in [\"Facility\", \"Coil Supplier\", \"Controls Revision\", \"Product Family\", \"Shift\", \"risk\"]:\n",
    "    print(b); print(table(b).to_string(index=False), \"\\n\")\n",
    "\n",
    "# excess cost from the risk group vs. the no-risk baseline\n",
    "base = df[df.risk == 0].cost.mean(); r = df[df.risk == 1]\n",
    "excess = r.cost.sum() - len(r) * base\n",
    "print(f\"baseline {base:.0f} | excess {excess:.0f} = {100*excess/TOT:.1f}% of total\")"
   ]
