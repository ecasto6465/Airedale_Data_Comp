    "#1.2\n",
    "import numpy as np, pandas as pd\n",
    "from scipy.stats import chi2_contingency, chi2\n",
    "\n",
    "import statsmodels.formula.api as smf\n",
    "\n",
    "df = pd.read_excel(\"DataSets/Competition_Dataset_Final.xlsx\")\n",
    "df[\"ctrl\"] = (df[\"Failure Category\"] == \"Controls\").astype(int)\n",
    "df[\"leak\"] = (df[\"Failure Category\"] == \"Leak\").astype(int)\n",
    "df[\"RevA\"] = (df[\"Controls Revision\"] == \"Rev A\").astype(int)\n",
    "df[\"risk\"] = ((df[\"Facility\"] == \"Facility 2\") | (df[\"Coil Supplier\"] == \"Supplier B\")).astype(int)\n",
    "\n",
    "# ---- 1. EFFECT BY REVISION (exact intervals) ----\n",
    "t = df.groupby(\"Controls Revision\")[\"ctrl\"].agg(k=\"sum\", units=\"count\")\n",
    "t[\"rate\"] = t.k / t.units\n",
    "ci = [proportion_confint(k, n, method=\"beta\") for k, n in zip(t.k, t.units)]\n",
    "t[\"lo\"], t[\"hi\"] = [c[0] for c in ci], [c[1] for c in ci]\n",
    "print(t.round(3), \"\\n\")\n",
    "\n",
    "# cost of controls faults\n",
    "print(df[df.ctrl == 1].groupby(\"Controls Revision\")[\"Repair Cost Field Service\"]\n",
    "        .agg([\"count\", \"mean\", \"sum\"]).round(0), \"\\n\")\n",
    "\n",
    "# ---- 2. MODIFIERS: Rev A only, raw vs. among non-leak units ----\n",
    "a  = df[df.RevA == 1]\n",
    "nl = a[a.leak == 0]                      # remove the leak competition\n",
    "for v in [\"Facility\", \"Coil Supplier\", \"Product Family\", \"Shift\", \"Customer Region\"]:\n",
    "    raw, cond = a.groupby(v)[\"ctrl\"].mean(), nl.groupby(v)[\"ctrl\"].mean()\n",
    "    p_raw  = chi2_contingency(pd.crosstab(a[v],  a.ctrl))[1]\n",
    "    p_cond = chi2_contingency(pd.crosstab(nl[v], nl.ctrl))[1]\n",
    "    print(f\"{v}: raw p={p_raw:.3f} | among non-leak p={p_cond:.3f}\")\n",
    "    print(pd.DataFrame({\"raw\": raw, \"non-leak\": cond, \"n_nonleak\": nl.groupby(v).size()}).round(3), \"\\n\")\n",
    "\n",
    "# ---- 3. DOES THE RISK FLAG EXPLAIN THE DIP? ----\n",
    "print(a.groupby(\"risk\").agg(units=(\"ctrl\", \"size\"), leak=(\"leak\", \"mean\"), ctrl=(\"ctrl\", \"mean\")).round(3))\n",
    "\n",
    "# ---- 4. JOINT TEST: do all modifiers together add anything? ----\n",
    "m0 = smf.logit(\"ctrl ~ 1\", nl).fit(disp=0)\n",
    "m1 = smf.logit(\"ctrl ~ C(Facility) + C(Q('Coil Supplier')) + C(Q('Product Family')) + C(Shift)\", nl).fit(disp=0)\n",
    "lr = 2 * (m1.llf - m0.llf)\n",
    "print(f\"Joint LR test: chi2={lr:.2f}, df={m1.df_model:.0f}, p={chi2.sf(lr, m1.df_model):.3f}\")"
   ]
