    "#1.1 Finding where the leaks originate from\n",
    "import numpy as np, pandas as pd\n",
    "from scipy.optimize import minimize\n",
    "from scipy.stats import chi2_contingency\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.model_selection import RepeatedStratifiedKFold\n",
    "from statsmodels.stats.proportion import proportion_confint\n",
    "\n",
    "# ---------- 1. LOAD AND DEFINE VARIABLES ----------\n",
    "df = pd.read_excel(\"DataSets/Competition_Dataset_Final.xlsx\")\n",
    "df[\"leak\"] = (df[\"Failure Category\"] == \"Leak\").astype(int)       # outcome\n",
    "df[\"F2\"]   = (df[\"Facility\"] == \"Facility 2\").astype(int)          # predictor 1\n",
    "df[\"SB\"]   = (df[\"Coil Supplier\"] == \"Supplier B\").astype(int)     # predictor 2\n",
    "df[\"F2xSB\"]= df[\"F2\"] * df[\"SB\"]\n",
    "\n",
    "# ---------- 2. THE 2x2 TABLE WITH EXACT INTERVALS ----------\n",
